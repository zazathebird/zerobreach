{
  // Phase 4 — Credential Access signature data.
  // Detection here is by hash and signature, never by bare filename (spec §3):
  // name-only matches raise POSSIBLE at most; the scanner enforces the corroboration rule.
  "sets": {

    // Hash-confirmed known-bad credential dumpers. Intentionally shipped EMPTY:
    // populate via a vetted external rules file (--rules) or custom IOC file — no
    // unverified hashes are baked into the engine. A SHA-256 match here is the only
    // thing that ever justifies CRITICAL + hash-confirmed in CRED-001.
    "credentialaccess.known_bad_hashes": [],

    // Well-known credential-dumping tool file names. Name match alone = POSSIBLE,
    // "not corroborated" — a file named mimikatz.exe might be a renamed calculator.
    "credentialaccess.dumper_names": [
      { "pattern": "mimikatz*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Mimikatz tool name" },
      { "pattern": "mimilib.dll", "kind": "literal", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Mimikatz SSP DLL name" },
      { "pattern": "mimidrv.sys", "kind": "literal", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Mimikatz driver name" },
      { "pattern": "wce*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Windows Credential Editor name" },
      { "pattern": "pwdump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "pwdump family name" },
      { "pattern": "fgdump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "fgdump name" },
      { "pattern": "gsecdump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "gsecdump name" },
      { "pattern": "cachedump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.005", "techniqueName": "OS Credential Dumping: Cached Domain Credentials", "tactic": "Credential Access", "note": "cachedump name" },
      { "pattern": "quarkspwdump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "Quarks PwDump name" },
      { "pattern": "lazagne*.exe", "kind": "glob", "severity": "possible", "technique": "T1555", "techniqueName": "Credentials from Password Stores", "tactic": "Credential Access", "note": "LaZagne name" },
      { "pattern": "pypykatz*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "pypykatz name" },
      { "pattern": "nanodump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "nanodump name" },
      { "pattern": "dumpert*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Outflank Dumpert name" },
      { "pattern": "sharpkatz*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "SharpKatz name" },
      { "pattern": "safetykatz*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "SafetyKatz name" },
      { "pattern": "sharpdump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "SharpDump name" },
      { "pattern": "handlekatz*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "HandleKatz name" },
      { "pattern": "kekeo*.exe", "kind": "glob", "severity": "possible", "technique": "T1558", "techniqueName": "Steal or Forge Kerberos Tickets", "tactic": "Credential Access", "note": "Kekeo name" },
      { "pattern": "rubeus*.exe", "kind": "glob", "severity": "possible", "technique": "T1558", "techniqueName": "Steal or Forge Kerberos Tickets", "tactic": "Credential Access", "note": "Rubeus name" },
      { "pattern": "procdump*.exe", "kind": "glob", "severity": "possible", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Sysinternals ProcDump — DUAL-USE admin tool; flag, never auto-act" }
    ],

    // Embedded strings characteristic of credential dumpers, matched inside candidate
    // binaries (bounded read). These can appear in AV/research/documentation material,
    // so every entry needs corroboration (an unsigned/invalid Authenticode state) before
    // the scanner may raise above POSSIBLE.
    "credentialaccess.dumper_content_strings": [
      { "pattern": "sekurlsa::logonpasswords", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "sekurlsa::minidump", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "lsadump::sam", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "lsadump::dcsync", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.006", "techniqueName": "OS Credential Dumping: DCSync", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "lsadump::secrets", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.004", "techniqueName": "OS Credential Dumping: LSA Secrets", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "privilege::debug", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "token::elevate", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1134", "techniqueName": "Access Token Manipulation", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "kerberos::golden", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1558.001", "techniqueName": "Steal or Forge Kerberos Tickets: Golden Ticket", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "dpapi::masterkey", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1555", "techniqueName": "Credentials from Password Stores", "tactic": "Credential Access", "note": "Mimikatz module command" },
      { "pattern": "gentilkiwi", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "Mimikatz author string" },
      { "pattern": "mimikatz", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "tool name embedded in binary" },
      { "pattern": "lazagne", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1555", "techniqueName": "Credentials from Password Stores", "tactic": "Credential Access", "note": "tool name embedded in binary" },
      { "pattern": "pypykatz", "kind": "literal", "substring": true, "needsCorroboration": true, "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "tool name embedded in binary" }
    ],

    // Command-line patterns for credential-adjacent scheduled tasks / services (CRED-007),
    // matched against Exec Command+Arguments and service ImagePath/ServiceDll.
    "credentialaccess.cred_command_patterns": [
      { "pattern": "reg(\\.exe)?\\s+save\\s+(hklm|hkey_local_machine)[\\\\/](sam|security|system)", "kind": "regex", "severity": "high", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "reg save of a credential hive" },
      { "pattern": "ntdsutil(\\.exe)?.*(\\bifm\\b|ac\\s+i\\s+ntds|create\\s+full)", "kind": "regex", "severity": "high", "technique": "T1003.003", "techniqueName": "OS Credential Dumping: NTDS", "tactic": "Credential Access", "note": "ntdsutil media-set / NTDS extraction" },
      { "pattern": "esentutl(\\.exe)?\\s+.*/(y|vss).*(\\\\sam\\b|\\\\security\\b|\\\\system\\b|ntds\\.dit)", "kind": "regex", "severity": "high", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "esentutl copy of a hive / NTDS.dit" },
      { "pattern": "vaultcmd(\\.exe)?\\s+/list", "kind": "regex", "severity": "high", "technique": "T1555.004", "techniqueName": "Credentials from Password Stores: Windows Credential Manager", "tactic": "Credential Access", "note": "vaultcmd credential enumeration" },
      { "pattern": "cmdkey(\\.exe)?\\s+/list", "kind": "regex", "severity": "high", "technique": "T1555.004", "techniqueName": "Credentials from Password Stores: Windows Credential Manager", "tactic": "Credential Access", "note": "cmdkey credential enumeration" },
      { "pattern": "comsvcs(\\.dll)?\\s*,?\\s*(#24|minidump)", "kind": "regex", "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "comsvcs.dll MiniDump LOLBin technique" },
      { "pattern": "procdump[^&|;]*lsass", "kind": "regex", "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "procdump aimed at lsass" },
      { "pattern": "mimikatz|sekurlsa|dcsync", "kind": "regex", "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "dumper keyword in a persisted command line" }
    ],

    // reg save / hive-copy residue names. Names only PRIORTIZE; the scanner confirms by
    // 'regf' header magic (or ESE magic for ntds.dit) before going above POSSIBLE.
    "credentialaccess.hive_copy_names": [
      { "pattern": "sam", "kind": "literal", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "bare SAM hive name" },
      { "pattern": "system", "kind": "literal", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "bare SYSTEM hive name" },
      { "pattern": "security", "kind": "literal", "severity": "possible", "technique": "T1003.004", "techniqueName": "OS Credential Dumping: LSA Secrets", "tactic": "Credential Access", "note": "bare SECURITY hive name" },
      { "pattern": "sam.*", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "SAM hive copy (sam.save/sam.bak/sam.hiv)" },
      { "pattern": "system.sav*", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "SYSTEM hive copy" },
      { "pattern": "system.bak", "kind": "literal", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "SYSTEM hive copy" },
      { "pattern": "system.hiv*", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "SYSTEM hive copy" },
      { "pattern": "security.sav*", "kind": "glob", "severity": "possible", "technique": "T1003.004", "techniqueName": "OS Credential Dumping: LSA Secrets", "tactic": "Credential Access", "note": "SECURITY hive copy" },
      { "pattern": "security.bak", "kind": "literal", "severity": "possible", "technique": "T1003.004", "techniqueName": "OS Credential Dumping: LSA Secrets", "tactic": "Credential Access", "note": "SECURITY hive copy" },
      { "pattern": "security.hiv*", "kind": "glob", "severity": "possible", "technique": "T1003.004", "techniqueName": "OS Credential Dumping: LSA Secrets", "tactic": "Credential Access", "note": "SECURITY hive copy" },
      { "pattern": "*.hiv", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "generic saved-hive extension" },
      { "pattern": "*.hive", "kind": "glob", "severity": "possible", "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access", "note": "generic saved-hive extension" },
      { "pattern": "ntds.dit", "kind": "literal", "severity": "possible", "technique": "T1003.003", "techniqueName": "OS Credential Dumping: NTDS", "tactic": "Credential Access", "note": "AD database copy outside %SystemRoot%\\NTDS" }
    ],

    // LSASS dump file name patterns (CRED-004). Content (minidump header + lsass module
    // string) is what confirms; name alone is POSSIBLE.
    "credentialaccess.dump_name_patterns": [
      { "pattern": "*lsass*.dmp", "kind": "glob", "severity": "critical", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "LSASS-named dump file" },
      { "pattern": "*lsass*.mdmp", "kind": "glob", "severity": "critical", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "LSASS-named dump file" }
    ],

    // Browser credential-store file names (CRED-006) — flagged only when found OUTSIDE
    // their normal profile location. The scanner never opens these files.
    "credentialaccess.browser_cred_files": [
      { "pattern": "Login Data", "kind": "literal", "severity": "high", "technique": "T1555.003", "techniqueName": "Credentials from Password Stores: Credentials from Web Browsers", "tactic": "Credential Access", "note": "Chromium password store copied out of place" },
      { "pattern": "Login Data For Account", "kind": "literal", "severity": "high", "technique": "T1555.003", "techniqueName": "Credentials from Password Stores: Credentials from Web Browsers", "tactic": "Credential Access", "note": "Chromium password store copied out of place" },
      { "pattern": "logins.json", "kind": "literal", "severity": "high", "technique": "T1555.003", "techniqueName": "Credentials from Password Stores: Credentials from Web Browsers", "tactic": "Credential Access", "note": "Firefox password store copied out of place" },
      { "pattern": "key4.db", "kind": "literal", "severity": "high", "technique": "T1555.003", "techniqueName": "Credentials from Password Stores: Credentials from Web Browsers", "tactic": "Credential Access", "note": "Firefox key database copied out of place" },
      { "pattern": "key3.db", "kind": "literal", "severity": "high", "technique": "T1555.003", "techniqueName": "Credentials from Password Stores: Credentials from Web Browsers", "tactic": "Credential Access", "note": "legacy Firefox key database copied out of place" },
      { "pattern": "signons.sqlite", "kind": "literal", "severity": "high", "technique": "T1555.003", "techniqueName": "Credentials from Password Stores: Credentials from Web Browsers", "tactic": "Credential Access", "note": "legacy Firefox password store copied out of place" },
      { "pattern": "Local State", "kind": "literal", "severity": "possible", "needsCorroboration": true, "technique": "T1555.003", "techniqueName": "Credentials from Password Stores: Credentials from Web Browsers", "tactic": "Credential Access", "note": "Chromium key file — common name, many CEF apps ship one" }
    ],

    // Source images considered benign for Sysmon EID 10 lsass access (CRED-004 noise
    // filter). Matched against the full SourceImage path.
    "credentialaccess.lsass_access_benign_sources": [
      { "pattern": "*\\msmpeng.exe", "kind": "glob", "severity": "info", "note": "Microsoft Defender engine" },
      { "pattern": "*\\mssense.exe", "kind": "glob", "severity": "info", "note": "Microsoft Defender for Endpoint" },
      { "pattern": "*\\csrss.exe", "kind": "glob", "severity": "info", "note": "Windows subsystem process" },
      { "pattern": "*\\wininit.exe", "kind": "glob", "severity": "info", "note": "Windows startup process" },
      { "pattern": "*\\services.exe", "kind": "glob", "severity": "info", "note": "Service Control Manager" },
      { "pattern": "*\\lsm.exe", "kind": "glob", "severity": "info", "note": "Local Session Manager" },
      { "pattern": "*\\svchost.exe", "kind": "glob", "severity": "info", "note": "service host" },
      { "pattern": "*\\wmiprvse.exe", "kind": "glob", "severity": "info", "note": "WMI provider host" },
      { "pattern": "*\\taskmgr.exe", "kind": "glob", "severity": "info", "note": "Task Manager" },
      { "pattern": "*\\procexp.exe", "kind": "glob", "severity": "info", "note": "Sysinternals Process Explorer" },
      { "pattern": "*\\procexp64.exe", "kind": "glob", "severity": "info", "note": "Sysinternals Process Explorer" },
      { "pattern": "*\\perfmon.exe", "kind": "glob", "severity": "info", "note": "Performance Monitor" },
      { "pattern": "*\\vmtoolsd.exe", "kind": "glob", "severity": "info", "note": "VMware Tools" },
      { "pattern": "*\\sysmon.exe", "kind": "glob", "severity": "info", "note": "Sysmon itself" },
      { "pattern": "*\\sysmon64.exe", "kind": "glob", "severity": "info", "note": "Sysmon itself" }
    ],

    // Defender ASR rule id for "Block credential stealing from LSASS" — matched as a
    // substring of Defender operational event XML (EID 1121/1122).
    "credentialaccess.defender_asr_lsass_rules": [
      { "pattern": "9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2", "kind": "literal", "substring": true, "severity": "high", "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access", "note": "ASR: block credential stealing from LSASS" }
    ]
  }
}
