      { "pattern": "*.microsoft.com", "kind": "glob", "severity": "info", "note": "Microsoft services/telemetry" },
      { "pattern": "*.windowsupdate.com", "kind": "glob", "severity": "info", "note": "Windows Update" },
      { "pattern": "*.windows.com", "kind": "glob", "severity": "info", "note": "Windows services" },
      { "pattern": "*.msftconnecttest.com", "kind": "glob", "severity": "info", "note": "connectivity probe" },
      { "pattern": "*.msftncsi.com", "kind": "glob", "severity": "info", "note": "connectivity probe" },
      { "pattern": "*.msedge.net", "kind": "glob", "severity": "info", "note": "Microsoft CDN" },
      { "pattern": "*.azureedge.net", "kind": "glob", "severity": "info", "note": "Microsoft CDN" },
      { "pattern": "*.office.com", "kind": "glob", "severity": "info", "note": "Office services" },
      { "pattern": "*.office365.com", "kind": "glob", "severity": "info", "note": "Office services" },
      { "pattern": "*.live.com", "kind": "glob", "severity": "info", "note": "Microsoft account services" },
      { "pattern": "*.digicert.com", "kind": "glob", "severity": "info", "note": "certificate revocation checks" },
      { "pattern": "*.verisign.com", "kind": "glob", "severity": "info", "note": "certificate revocation checks" },
      { "pattern": "*.symantec.com", "kind": "glob", "severity": "info", "note": "AV vendor" },
      { "pattern": "*.mcafee.com", "kind": "glob", "severity": "info", "note": "AV vendor" },
      { "pattern": "*.eset.com", "kind": "glob", "severity": "info", "note": "AV vendor" },
      { "pattern": "*.kaspersky.com", "kind": "glob", "severity": "info", "note": "AV vendor" },
