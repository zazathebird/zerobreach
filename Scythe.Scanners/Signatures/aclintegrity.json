{
  // Phase 8 — Permission / ACL Integrity. Audit-target lists for AclIntegrityScanner.
  // These are STRUCTURAL expectations (paths whose ACLs/owners must be admin-controlled),
  // not machine-specific baselines. Principal matching is done by well-known SID in the
  // scanner, never by localized account name. Entry severity = severity of a
  // broad-principal WRITE grant on that target; ownership anomalies are always Possible.
  "sets": {
    "aclintegrity.system_dirs": [
      { "pattern": "%SystemRoot%", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "Windows directory" },
      { "pattern": "%SystemRoot%\\System32", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "System32 — writable = direct privilege-escalation primitive" },
      { "pattern": "%SystemRoot%\\SysWOW64", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "32-bit system directory" },
      { "pattern": "%SystemRoot%\\System32\\drivers", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "kernel driver directory" },
      { "pattern": "%ProgramFiles%", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "Program Files root — many service binaries resolve here" },
      { "pattern": "%ProgramFiles(x86)%", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "Program Files (x86) root" },
      { "pattern": "%ProgramData%", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "ProgramData root — resolves into many service/task paths (note: CreateFiles for Users here is a Windows default; only Delete/DACL/owner rights are flagged)" }
    ],
    "aclintegrity.system_binaries": [
      { "pattern": "%SystemRoot%\\explorer.exe", "kind": "literal", "severity": "high",
        "technique": "T1574.005", "techniqueName": "Executable Installer File Permissions Weakness",
        "tactic": "Privilege Escalation", "note": "shell binary" },
      { "pattern": "%SystemRoot%\\System32\\cmd.exe", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "command interpreter" },
      { "pattern": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "PowerShell host" },
      { "pattern": "%SystemRoot%\\System32\\services.exe", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "Service Control Manager" },
      { "pattern": "%SystemRoot%\\System32\\lsass.exe", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "LSASS" },
      { "pattern": "%SystemRoot%\\System32\\winlogon.exe", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "winlogon" },
      { "pattern": "%SystemRoot%\\System32\\svchost.exe", "kind": "literal", "severity": "high",
        "technique": "T1574.010", "techniqueName": "Services File Permissions Weakness",
        "tactic": "Privilege Escalation", "note": "shared service host — hosts most Windows services" },
      { "pattern": "%SystemRoot%\\System32\\taskhostw.exe", "kind": "literal", "severity": "high",
        "technique": "T1222.001", "techniqueName": "Windows File and Directory Permissions Modification",
        "tactic": "Defense Evasion", "note": "task host" },
      { "pattern": "%SystemRoot%\\System32\\sethc.exe", "kind": "literal", "severity": "high",
        "technique": "T1546.008", "techniqueName": "Accessibility Features",
        "tactic": "Privilege Escalation", "note": "sticky keys — classic accessibility-hijack target" },
      { "pattern": "%SystemRoot%\\System32\\utilman.exe", "kind": "literal", "severity": "high",
        "technique": "T1546.008", "techniqueName": "Accessibility Features",
        "tactic": "Privilege Escalation", "note": "utility manager — accessibility-hijack target" },
      { "pattern": "%SystemRoot%\\System32\\osk.exe", "kind": "literal", "severity": "high",
        "technique": "T1546.008", "techniqueName": "Accessibility Features",
        "tactic": "Privilege Escalation", "note": "on-screen keyboard — accessibility-hijack target" },
      { "pattern": "%SystemRoot%\\System32\\Magnify.exe", "kind": "literal", "severity": "high",
        "technique": "T1546.008", "techniqueName": "Accessibility Features",
        "tactic": "Privilege Escalation", "note": "magnifier — accessibility-hijack target" },
      { "pattern": "%SystemRoot%\\System32\\Narrator.exe", "kind": "literal", "severity": "high",
        "technique": "T1546.008", "techniqueName": "Accessibility Features",
        "tactic": "Privilege Escalation", "note": "narrator — accessibility-hijack target" },
      { "pattern": "%SystemRoot%\\System32\\DisplaySwitch.exe", "kind": "literal", "severity": "high",
        "technique": "T1546.008", "techniqueName": "Accessibility Features",
        "tactic": "Privilege Escalation", "note": "display switch — accessibility-hijack target" },
      { "pattern": "%SystemRoot%\\System32\\AtBroker.exe", "kind": "literal", "severity": "high",
        "technique": "T1546.008", "techniqueName": "Accessibility Features",
        "tactic": "Privilege Escalation", "note": "assistive technology broker — accessibility-hijack target" }
    ],
    "aclintegrity.startup_dirs": [
      { "pattern": "%ProgramData%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup", "kind": "literal", "severity": "high",
        "technique": "T1547.001", "techniqueName": "Registry Run Keys / Startup Folder",
        "tactic": "Persistence", "note": "all-users Startup folder — anything dropped here runs at every logon" },
      { "pattern": "%ProgramData%\\Microsoft\\Windows\\Start Menu", "kind": "literal", "severity": "high",
        "technique": "T1547.001", "techniqueName": "Registry Run Keys / Startup Folder",
        "tactic": "Persistence", "note": "all-users Start Menu root" },
      { "pattern": "%SystemRoot%\\System32\\Tasks", "kind": "literal", "severity": "high",
        "technique": "T1053.005", "techniqueName": "Scheduled Task",
        "tactic": "Persistence", "note": "scheduled task definition store (Authenticated Users create rights are a Windows default here; only Delete/DACL/owner rights are flagged)" },
      { "pattern": "%SystemRoot%\\Tasks", "kind": "literal", "severity": "high",
        "technique": "T1053.005", "techniqueName": "Scheduled Task",
        "tactic": "Persistence", "note": "legacy scheduled task directory (Authenticated Users create rights are a Windows default here; only Delete/DACL/owner rights are flagged)" }
    ]
  }
}
