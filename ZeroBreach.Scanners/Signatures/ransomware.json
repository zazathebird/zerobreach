{
  // Phase 5 — Ransomware Indicators. All patterns here are data, never inline in the
  // scanner (spec: signatures live in external files so the engine stays AV-readable and
  // updates don't touch logic).
  //
  // No "known_bad_hashes" set ships here: we have no verified SHA-256 corpus to embed and
  // fabricating hashes is worse than none. Operators can supply hashes via --ioc-file
  // (custom.hashes) or an external rules file.
  "sets": {

    // RANS-001 — ransom note FILENAME patterns. A name match alone is POSSIBLE; the
    // scanner escalates to CRITICAL only when note-like content markers also match.
    // Matched against the bare file name (case-insensitive).
    "ransomware.ransom_note_patterns": [
      { "pattern": "*how*to*decrypt*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic 'how to decrypt' note name" },
      { "pattern": "*decrypt*instruction*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic decrypt-instructions note name" },
      { "pattern": "*decrypt*my*files*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "Cerber-style note name" },
      { "pattern": "*decrypt*your*files*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic decrypt-your-files note name" },
      { "pattern": "*restore*files*.txt", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "restore-files style note (txt)" },
      { "pattern": "*restore*files*.hta", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "restore-files style note (hta)" },
      { "pattern": "*restore*files*.html", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "restore-files style note (html)" },
      { "pattern": "*_readme*.txt", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "underscore-readme note style (STOP/Djvu '_readme.txt', Clop '*_ReadMe*')" },
      { "pattern": "*your*files*encrypted*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic your-files-are-encrypted note name" },
      { "pattern": "*files*have*been*encrypted*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic files-have-been-encrypted note name" },
      { "pattern": "restore-my-files.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "LockBit note name" },
      { "pattern": "@please_read_me@.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "WannaCry note name" },
      { "pattern": "#decrypt_my_files#.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "Cerber note name" },
      { "pattern": "help_decrypt*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "CryptoWall-style HELP_DECRYPT.* note name" },
      { "pattern": "help_restore_files*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "TeslaCrypt-style note name" },
      { "pattern": "how to back files.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "MedusaLocker note name" },
      { "pattern": "ryukreadme.*", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "Ryuk note name" },
      { "pattern": "conti_readme.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "Conti note name" },
      { "pattern": "akira_readme.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "Akira note name" },
      { "pattern": "readme.hive.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "Hive note name" },
      { "pattern": "!want_to_cry.txt", "kind": "literal", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "WantToCry note name" },
      { "pattern": "*read*me*.hta", "kind": "glob", "severity": "possible",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "HTA-format read-me note" }
    ],

    // RANS-001 — note CONTENT markers, matched against a bounded (8 KB) read of a file
    // whose NAME already matched above. All carry needsCorroboration: a content string
    // alone (e.g. inside IR documentation) must never raise a finding above POSSIBLE —
    // here the corroboration is the ransom-note filename match itself.
    "ransomware.note_content_markers": [
      { "pattern": "[a-z2-7]{16,56}\\.onion", "kind": "regex", "severity": "critical",
        "needsCorroboration": true, "note": "Tor onion address" },
      { "pattern": "\\b(bc1[a-z0-9]{20,60}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\\b", "kind": "regex", "severity": "critical",
        "needsCorroboration": true, "note": "Bitcoin address pattern" },
      { "pattern": "\\b4[0-9AB][1-9A-HJ-NP-Za-km-z]{93}\\b", "kind": "regex", "severity": "critical",
        "needsCorroboration": true, "note": "Monero address pattern" },
      { "pattern": "your files have been encrypted", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "classic ransom note phrase" },
      { "pattern": "all your files", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "ransom note phrase" },
      { "pattern": "decrypt your files", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "ransom note phrase" },
      { "pattern": "to recover your files", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "ransom note phrase" },
      { "pattern": "decryption key", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "ransom note phrase" },
      { "pattern": "decryption tool", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "ransom note phrase" },
      { "pattern": "tor browser", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "payment-channel instruction phrase" },
      { "pattern": "do not rename encrypted files", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "ransom note phrase" },
      { "pattern": "your network has been penetrated", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "double-extortion note phrase" },
      { "pattern": "we have downloaded your data", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "double-extortion note phrase" },
      { "pattern": "pay the ransom", "kind": "literal", "substring": true, "severity": "critical",
        "needsCorroboration": true, "note": "ransom note phrase" }
    ],

    // RANS-002 — appended extensions of encrypted files. Family-specific extensions are
    // CRITICAL at a meaningful count; generic words that legitimate software also uses
    // (.locked, .encrypted, .wallet, .vault ...) carry needsCorroboration and are capped
    // at POSSIBLE unless a ransom note was also found. Matched as literal file extensions.
    "ransomware.known_ransom_extensions": [
      { "pattern": ".lockbit", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "LockBit" },
      { "pattern": ".abcd", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "LockBit v1" },
      { "pattern": ".conti", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Conti" },
      { "pattern": ".ryk", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Ryuk" },
      { "pattern": ".phobos", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Phobos" },
      { "pattern": ".makop", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Makop" },
      { "pattern": ".wncry", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "WannaCry" },
      { "pattern": ".wcry", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "WannaCry" },
      { "pattern": ".wncryt", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "WannaCry" },
      { "pattern": ".cerber", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Cerber" },
      { "pattern": ".cerber3", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Cerber" },
      { "pattern": ".locky", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Locky" },
      { "pattern": ".zepto", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Locky variant" },
      { "pattern": ".osiris", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Locky variant" },
      { "pattern": ".odin", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Locky variant" },
      { "pattern": ".aesir", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Locky variant" },
      { "pattern": ".dharma", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Dharma/CrySiS" },
      { "pattern": ".crysis", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "CrySiS" },
      { "pattern": ".krab", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "GandCrab" },
      { "pattern": ".gdcb", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "GandCrab v1" },
      { "pattern": ".djvu", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "STOP/Djvu" },
      { "pattern": ".basta", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Black Basta" },
      { "pattern": ".hive", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Hive" },
      { "pattern": ".akira", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Akira" },
      { "pattern": ".royal", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Royal" },
      { "pattern": ".clop", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Clop" },
      { "pattern": ".cl0p", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Clop" },
      { "pattern": ".avdn", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Avaddon" },
      { "pattern": ".babyk", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Babuk" },
      { "pattern": ".medusa", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "Medusa" },
      { "pattern": ".cryptolocker", "kind": "literal", "severity": "critical",
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact", "note": "CryptoLocker" },

      // Generic / dual-use extension words — legitimate software also produces these.
      { "pattern": ".encrypted", "kind": "literal", "severity": "high", "needsCorroboration": true,
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic 'encrypted' extension (also used by legitimate tools)" },
      { "pattern": ".crypted", "kind": "literal", "severity": "high", "needsCorroboration": true,
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic 'crypted' extension" },
      { "pattern": ".crypt", "kind": "literal", "severity": "high", "needsCorroboration": true,
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic 'crypt' extension (also used by legitimate tools)" },
      { "pattern": ".locked", "kind": "literal", "severity": "high", "needsCorroboration": true,
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic 'locked' extension (also used by legitimate lockfile schemes)" },
      { "pattern": ".ransom", "kind": "literal", "severity": "high", "needsCorroboration": true,
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "generic 'ransom' extension" },
      { "pattern": ".wallet", "kind": "literal", "severity": "high", "needsCorroboration": true,
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "Dharma variant extension, but also legitimate crypto-wallet files" },
      { "pattern": ".vault", "kind": "literal", "severity": "high", "needsCorroboration": true,
        "technique": "T1486", "techniqueName": "Data Encrypted for Impact", "tactic": "Impact",
        "note": "CrypVault-style extension, but also legitimate vault files" }
    ],

    // RANS-003 — extensions whose content is normally LOW entropy (plain text). .docx/.xlsx
    // are deliberately absent: they are ZIP containers and already near-random when healthy.
    "ransomware.entropy_target_extensions": [
      { "pattern": ".txt", "kind": "literal", "severity": "info", "note": "plain text" },
      { "pattern": ".csv", "kind": "literal", "severity": "info", "note": "plain text" },
      { "pattern": ".rtf", "kind": "literal", "severity": "info", "note": "mostly-text markup" },
      { "pattern": ".sql", "kind": "literal", "severity": "info", "note": "plain text" },
      { "pattern": ".log", "kind": "literal", "severity": "info", "note": "plain text" }
    ],

    // RANS-004 — recovery/shadow-copy tampering command patterns, matched against event
    // command lines (4688), PowerShell script blocks (4104), scheduled-task action XML and
    // service ImagePath values. Detection only: findings from these are NEVER executable
    // (spec §3 / §6.8).
    "ransomware.recovery_tamper_commands": [
      { "pattern": "vssadmin(\\.exe)?\\s+delete\\s+shadows", "kind": "regex", "severity": "critical",
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "shadow copy deletion" },
      { "pattern": "wmic(\\.exe)?\\s+shadowcopy\\s+delete", "kind": "regex", "severity": "critical",
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "shadow copy deletion via WMIC" },
      { "pattern": "win32_shadowcopy[^\\r\\n]{0,120}(delete|remove)", "kind": "regex", "severity": "critical",
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "shadow copy deletion via WMI class" },
      { "pattern": "wbadmin(\\.exe)?\\s+delete\\s+catalog", "kind": "regex", "severity": "critical",
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "backup catalog deletion" },
      { "pattern": "wbadmin(\\.exe)?\\s+delete\\s+systemstatebackup", "kind": "regex", "severity": "critical",
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "system state backup deletion" },
      { "pattern": "bcdedit(\\.exe)?\\s+/set\\s+[^\\r\\n]{0,80}recoveryenabled\\s+(no|off)", "kind": "regex", "severity": "critical",
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "Windows recovery environment disabled" },
      { "pattern": "bcdedit(\\.exe)?\\s+/set\\s+[^\\r\\n]{0,80}bootstatuspolicy\\s+ignoreallfailures", "kind": "regex", "severity": "critical",
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "boot failure recovery suppressed" },
      { "pattern": "vssadmin(\\.exe)?\\s+resize\\s+shadowstorage", "kind": "regex", "severity": "high",
        "needsCorroboration": true,
        "technique": "T1490", "techniqueName": "Inhibit System Recovery", "tactic": "Impact",
        "note": "shadow storage resize (Ryuk/Conti purge trick, but also legitimate admin work)" }
    ]
  }
}
