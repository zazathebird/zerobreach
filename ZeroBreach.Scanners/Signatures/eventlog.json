        "note": "service binary under Users\\Public" },
      { "pattern": "(powershell|pwsh|mshta|wscript|cscript|cmd\\.exe\\s*/c)", "kind": "regex", "severity": "high",
        "technique": "T1543.003", "techniqueName": "Create or Modify System Process: Windows Service", "tactic": "Persistence",
        "note": "service ImagePath invokes a script interpreter" },
      { "pattern": "*\\users\\*", "kind": "glob", "severity": "possible",
        "technique": "T1543.003", "techniqueName": "Create or Modify System Process: Windows Service", "tactic": "Persistence",
        "note": "service binary under a user profile", "needsCorroboration": true },
      { "pattern": "*\\programdata\\*", "kind": "glob", "severity": "possible",
        "technique": "T1543.003", "techniqueName": "Create or Modify System Process: Windows Service", "tactic": "Persistence",
        "note": "service binary under ProgramData — some legitimate agents do this", "needsCorroboration": true },
      { "pattern": "\\\\*", "kind": "glob", "severity": "possible",
        "technique": "T1543.003", "techniqueName": "Create or Modify System Process: Windows Service", "tactic": "Persistence",
        "note": "service binary on a UNC/network path", "needsCorroboration": true }
    ],

    // Platform services that legitimately install, run and remove themselves — the
    // install-run-remove shape EVTX-002 treats as an attacker pattern. Without this set,
    // Microsoft Defender's randomly-named MpKsl definition drivers raise a HIGH 7045 finding
    // on every clean Windows machine. Matching here never suppresses the finding; it only
    // stops the transient-service escalation (see ReportServiceInstall).
    "eventlog.service_install_benign_transient": [
      { "pattern": "MpKsl*", "kind": "glob", "severity": "info",
        "note": "Microsoft Defender kernel-mode definition driver (MpKsl*), installed and removed with each definition update" },
      { "pattern": "*\\microsoft\\windows defender\\definition updates\\*", "kind": "glob", "severity": "info",
        "note": "Microsoft Defender definition-update payload directory" }
    ]
  }
}
