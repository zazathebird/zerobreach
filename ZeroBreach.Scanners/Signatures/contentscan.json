      // --- Webshell residue ---
      { "pattern": "eval(base64_decode(", "kind": "literal", "substring": true, "severity": "high", "needsCorroboration": true,
        "technique": "T1505.003", "techniqueName": "Server Software Component: Web Shell", "tactic": "Persistence",
