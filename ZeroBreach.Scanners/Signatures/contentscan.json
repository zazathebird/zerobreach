    // Non-executable extensions the matcher magic-sniffs: a file with one of these names
    // whose first bytes are the PE 'MZ' header is an executable masquerading as a
    // document/media file (CONT-002). Scope list, severity applies to the mismatch finding.
    "contentscan.doc_masquerade_ext": [
      { "pattern": "*.txt",  "kind": "glob", "severity": "possible", "technique": "T1036.008", "techniqueName": "Masquerading: Masquerade File Type", "tactic": "Defense Evasion" },
      { "pattern": "*.log",  "kind": "glob", "severity": "possible", "technique": "T1036.008", "techniqueName": "Masquerading: Masquerade File Type", "tactic": "Defense Evasion" },
