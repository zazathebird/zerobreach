      { "pattern": "*.rtf",  "kind": "glob", "severity": "possible", "technique": "T1036.008", "techniqueName": "Masquerading: Masquerade File Type", "tactic": "Defense Evasion" },
      { "pattern": "*.pdf",  "kind": "glob", "severity": "possible", "technique": "T1036.008", "techniqueName": "Masquerading: Masquerade File Type", "tactic": "Defense Evasion" },
      { "pattern": "*.doc",  "kind": "glob", "severity": "possible", "technique": "T1036.008", "techniqueName": "Masquerading: Masquerade File Type", "tactic": "Defense Evasion" },
