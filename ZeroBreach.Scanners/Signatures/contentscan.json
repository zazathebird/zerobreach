    // Filename manipulation tricks (CONT-003) — matched against the file NAME. These have
    // essentially no legitimate use, so they fire without content corroboration.
    "contentscan.filename_tricks": [
      { "pattern": "[\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]", "kind": "regex", "severity": "high",
        "technique": "T1036.002", "techniqueName": "Masquerading: Right-to-Left Override", "tactic": "Defense Evasion",
        "note": "Unicode bidirectional-override control character in filename" },
      { "pattern": "\\.(docx?|xlsx?|pptx?|pdf|txt|rtf|csv|jpe?g|png|gif|bmp|mp3|mp4|avi|zip|7z|rar)\\s?\\.(exe|scr|com|pif|bat|cmd|vbs|vbe|js|jse|wsf|hta|lnk)$", "kind": "regex", "severity": "high",
        "technique": "T1036.007", "techniqueName": "Masquerading: Double File Extension", "tactic": "Defense Evasion",
        "note": "document/media extension immediately followed by an executable extension" },
      { "pattern": "\\S[ ]{4,}[^ ]*\\.(exe|scr|com|pif|bat|cmd|vbs|js|hta|lnk)$", "kind": "regex", "severity": "high",
        "technique": "T1036.006", "techniqueName": "Masquerading: Space after Filename", "tactic": "Defense Evasion",
        "note": "whitespace padding hiding an executable extension" },
      { "pattern": "[Ѐ-ӿ].*\\.(exe|scr|com|bat|cmd|lnk)$", "kind": "regex", "severity": "high",
        "technique": "T1036", "techniqueName": "Masquerading", "tactic": "Defense Evasion",
        "note": "Cyrillic homoglyph characters in an executable filename" }
    ],

    // Hash-confirmed known-bad set (CONT-004). Shipped EMPTY on purpose: no hashes are
    // fabricated. Operators extend this via an external rules file (--rules) or supply
    // hashes through --ioc-file (those land in custom.hashes and are matched as Possible).
    "contentscan.known_bad_hashes": []
  }
