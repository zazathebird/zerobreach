  // Phase 9 — Content Scan (YARA-lite) signature data.
  //
  // Every content-string indicator here carries needsCorroboration:true (spec §3): a single
  // hit can NEVER justify above Possible — a document that merely *mentions* a malware
  // family (research, vendor advisories, IR notes, this project's own spec) must not be
  // escalated. The scanner escalates only when 2+ independent indicators corroborate.
  //
  // Severities are the value used WHEN corroborated; uncorroborated hits are capped at
  // possible by the scanner regardless of what is written here.
  "sets": {

    "contentscan.malware_strings": [
      // --- Credential dumping (Mimikatz and friends) ---
      { "pattern": "sekurlsa::logonpasswords", "kind": "literal", "substring": true, "severity": "high", "needsCorroboration": true,
        "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access",
        "note": "Mimikatz sekurlsa module command string" },
      { "pattern": "lsadump::sam", "kind": "literal", "substring": true, "severity": "high", "needsCorroboration": true,
        "technique": "T1003.002", "techniqueName": "OS Credential Dumping: Security Account Manager", "tactic": "Credential Access",
        "note": "Mimikatz lsadump module command string" },
      { "pattern": "privilege::debug", "kind": "literal", "substring": true, "severity": "high", "needsCorroboration": true,
        "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access",
        "note": "Mimikatz privilege-escalation command string" },
      { "pattern": "gentilkiwi", "kind": "literal", "substring": true, "severity": "high", "needsCorroboration": true,
        "technique": "T1003.001", "techniqueName": "OS Credential Dumping: LSASS Memory", "tactic": "Credential Access",
        "note": "Mimikatz author handle embedded in binaries" },
      { "pattern": "kuhl_m_", "kind": "literal", "substring": true, "severity": "high", "needsCorroboration": true,
