    "emailresidue.macro_zip_member": [
      { "pattern": "vbaProject.bin", "kind": "literal", "substring": true, "severity": "high", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "embedded VBA project inside the OOXML container" }
    ],

    "emailresidue.archive_ext": [
      { "pattern": "*.zip", "kind": "glob", "severity": "info", "note": "archive inspected via zip central directory only — members are never extracted" }
    ],

