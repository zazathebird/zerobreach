    "emailresidue.double_ext": [
      { "pattern": "\\.(pdf|docx?|xlsx?|pptx?|rtf|txt|csv|jpe?g|png|gif|html?|mp[34])\\s{0,4}\\.(exe|scr|pif|com|js|jse|vbs|vbe|wsf|hta|bat|cmd|ps1|lnk|msi)$", "kind": "regex", "severity": "high", "technique": "T1036.007", "techniqueName": "Masquerading: Double File Extension", "tactic": "Defense Evasion", "note": "document-typed name in front of an executable extension — essentially no legitimate use" }
