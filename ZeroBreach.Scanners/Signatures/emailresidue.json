{
  // Phase 6 — Email / Phishing Residue signature data.
  // Scope (spec §3): the mail ATTACHMENT CACHE only — these sets drive matching over
  // Outlook SecureTemp / Content.Outlook cache files and Downloads provenance, never
  // over an OST/PST mail store.
  // NOTE: no known-bad SHA-256 set ships by default (nothing fabricated); an operator
  // rules file may add "emailresidue.known_bad_sha256" entries and the scanner will
  // honor them (hash-confirmed => delete allowed per spec §6.4).
  "sets": {

    "emailresidue.cache_suspect_ext": [
      { "pattern": "*.exe", "kind": "glob", "severity": "high", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "raw executable opened from an email" },
      { "pattern": "*.scr", "kind": "glob", "severity": "high", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "screensaver executable delivered by mail" },
      { "pattern": "*.pif", "kind": "glob", "severity": "high", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "PIF executable delivered by mail" },
      { "pattern": "*.com", "kind": "glob", "severity": "high", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "COM executable delivered by mail" },
      { "pattern": "*.js",  "kind": "glob", "severity": "high", "technique": "T1059.007", "techniqueName": "Command and Scripting Interpreter: JavaScript", "tactic": "Execution", "note": "JScript file opened from an email" },
      { "pattern": "*.jse", "kind": "glob", "severity": "high", "technique": "T1059.007", "techniqueName": "Command and Scripting Interpreter: JavaScript", "tactic": "Execution", "note": "encoded JScript file opened from an email" },
      { "pattern": "*.vbs", "kind": "glob", "severity": "high", "technique": "T1059.005", "techniqueName": "Command and Scripting Interpreter: Visual Basic", "tactic": "Execution", "note": "VBScript file opened from an email" },
      { "pattern": "*.vbe", "kind": "glob", "severity": "high", "technique": "T1059.005", "techniqueName": "Command and Scripting Interpreter: Visual Basic", "tactic": "Execution", "note": "encoded VBScript file opened from an email" },
      { "pattern": "*.wsf", "kind": "glob", "severity": "high", "technique": "T1059.005", "techniqueName": "Command and Scripting Interpreter: Visual Basic", "tactic": "Execution", "note": "Windows Script File opened from an email" },
      { "pattern": "*.wsh", "kind": "glob", "severity": "high", "technique": "T1059.005", "techniqueName": "Command and Scripting Interpreter: Visual Basic", "tactic": "Execution", "note": "Windows Script Host settings/script file opened from an email" },
      { "pattern": "*.hta", "kind": "glob", "severity": "high", "technique": "T1218.005", "techniqueName": "System Binary Proxy Execution: Mshta", "tactic": "Defense Evasion", "note": "HTML application opened from an email" },
      { "pattern": "*.bat", "kind": "glob", "severity": "high", "technique": "T1059.003", "techniqueName": "Command and Scripting Interpreter: Windows Command Shell", "tactic": "Execution", "note": "batch file opened from an email" },
      { "pattern": "*.cmd", "kind": "glob", "severity": "high", "technique": "T1059.003", "techniqueName": "Command and Scripting Interpreter: Windows Command Shell", "tactic": "Execution", "note": "batch file opened from an email" },
      { "pattern": "*.ps1", "kind": "glob", "severity": "high", "technique": "T1059.001", "techniqueName": "Command and Scripting Interpreter: PowerShell", "tactic": "Execution", "note": "PowerShell script opened from an email" },
      { "pattern": "*.lnk", "kind": "glob", "severity": "high", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "shortcut delivered by mail — a common first-stage loader with no legitimate reason to be emailed" },
      { "pattern": "*.xll", "kind": "glob", "severity": "high", "technique": "T1137.006", "techniqueName": "Office Application Startup: Add-ins", "tactic": "Persistence", "note": "Excel add-in delivered by mail" },
      { "pattern": "*.chm", "kind": "glob", "severity": "high", "technique": "T1218.001", "techniqueName": "System Binary Proxy Execution: Compiled HTML File", "tactic": "Defense Evasion", "note": "compiled HTML help file delivered by mail" },
      { "pattern": "*.iso",  "kind": "glob", "severity": "possible", "technique": "T1553.005", "techniqueName": "Subvert Trust Controls: Mark-of-the-Web Bypass", "tactic": "Defense Evasion", "note": "disk-image container — MOTW does not propagate to its contents; a standard phishing delivery wrapper" },
      { "pattern": "*.img",  "kind": "glob", "severity": "possible", "technique": "T1553.005", "techniqueName": "Subvert Trust Controls: Mark-of-the-Web Bypass", "tactic": "Defense Evasion", "note": "disk-image container — MOTW does not propagate to its contents" },
      { "pattern": "*.vhd",  "kind": "glob", "severity": "possible", "technique": "T1553.005", "techniqueName": "Subvert Trust Controls: Mark-of-the-Web Bypass", "tactic": "Defense Evasion", "note": "virtual disk container — MOTW does not propagate to its contents" },
      { "pattern": "*.vhdx", "kind": "glob", "severity": "possible", "technique": "T1553.005", "techniqueName": "Subvert Trust Controls: Mark-of-the-Web Bypass", "tactic": "Defense Evasion", "note": "virtual disk container — MOTW does not propagate to its contents" },
      { "pattern": "*.udf",  "kind": "glob", "severity": "possible", "technique": "T1553.005", "techniqueName": "Subvert Trust Controls: Mark-of-the-Web Bypass", "tactic": "Defense Evasion", "note": "UDF disk-image container" },
      { "pattern": "*.one",  "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "OneNote file — abused as an embedded-payload carrier" },
      { "pattern": "*.svg",  "kind": "glob", "severity": "possible", "needsCorroboration": true, "technique": "T1027.006", "techniqueName": "Obfuscated Files or Information: HTML Smuggling", "tactic": "Defense Evasion", "note": "SVG attachment — can carry embedded script (smuggling); also very often legitimate" }
    ],

    "emailresidue.macro_ext": [
      { "pattern": "*.docm", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable Word document" },
      { "pattern": "*.dotm", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable Word template" },
      { "pattern": "*.xlsm", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable Excel workbook" },
