      { "pattern": "*.pptm", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable PowerPoint presentation" },
      { "pattern": "*.ppsm", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable PowerPoint slideshow" },
      { "pattern": "*.potm", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable PowerPoint template" },
      { "pattern": "*.sldm", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable PowerPoint slide" },
      { "pattern": "*.ppam", "kind": "glob", "severity": "possible", "technique": "T1204.002", "techniqueName": "User Execution: Malicious File", "tactic": "Execution", "note": "macro-capable PowerPoint add-in" }
